# ============================================================
# Student Dropout / Academic Analyser / Intervention Platform
# Copy to `.env` and fill in. NEVER commit the filled-in file.
#   cp .env.example .env
# ============================================================

# ------------------------------------------------------------
# Flask
# ------------------------------------------------------------
# Required in production: sessions are signed with this. If unset the app
# generates a random per-process key, which logs everyone out on restart.
SECRET_KEY=

FLASK_HOST=127.0.0.1
FLASK_PORT=5000
# The Werkzeug debugger is only ever enabled on a loopback bind.
FLASK_DEBUG=False

# Comma-separated list. Leave empty to disable CORS entirely (recommended:
# the dashboard is served same-origin, so it does not need CORS).
ALLOWED_ORIGINS=

# ------------------------------------------------------------
# Authentication backend
# ------------------------------------------------------------
# auto     -> Firebase when configured below, otherwise the legacy SQLite store
# firebase -> Firebase only (fails closed if unconfigured)
# legacy   -> SQLite session auth only
AUTH_BACKEND=auto

# ------------------------------------------------------------
# Firebase web configuration (PUBLIC BY DESIGN)
# ------------------------------------------------------------
# These are shipped to the browser and are not secrets. The security of the
# project comes from Firestore rules + backend authorization, not from hiding
# these values. Leave FIREBASE_STORAGE_BUCKET unset - Firebase Storage is
# intentionally NOT used.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=

# Invite code required to register a faculty/admin account.
ADMIN_INVITE_CODE=

# ------------------------------------------------------------
# Firebase Admin SDK (SERVER-SIDE SECRET - never expose to the browser)
# ------------------------------------------------------------
# Provide exactly ONE of the following:
#   * FIREBASE_SERVICE_ACCOUNT_FILE - path to the service-account JSON
#   * FIREBASE_SERVICE_ACCOUNT_JSON - the JSON itself (single line)
# If neither is set, Application Default Credentials are used.
FIREBASE_SERVICE_ACCOUNT_FILE=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Firebase session cookie lifetime in seconds (5 min .. 14 days).
FIREBASE_SESSION_EXPIRES_IN=43200

# ------------------------------------------------------------
# ML / data paths
# ------------------------------------------------------------
MODEL_DIR=models
DATASET_DIR=dataset

# Risk tier cutoffs. Medium is recall-oriented (see src/train_xgboost.py).
RISK_MEDIUM_THRESHOLD=0.243
RISK_HIGH_THRESHOLD=0.5
